---
import { searchIndex } from '../utils/searchIndex';
---

<script define:vars={{ searchIndex }}>
  window.__SEARCH_INDEX__ = searchIndex;
</script>

<div class="search-container relative w-full sm:w-52">
  <input
    id="search"
    type="search"
    aria-label="Search stuff and notes"
    aria-controls="results"
    placeholder="Search the archive…"
    spellcheck="false"
    autocomplete="off"
    class="px-4 py-2 w-full rounded-full bg-violet-400/10 backdrop-blur border border-violet-400/30 focus:outline-none focus:ring-2 focus:ring-violet-400/50 text-sm"
  />
  <div
    id="results"
    aria-label="Search results"
    class="search-scroll absolute z-50 mt-2 w-full rounded-xl bg-black/90 backdrop-blur-md border border-violet-400/20 shadow-lg shadow-black/30 hidden max-h-72 overflow-y-auto"
  ></div>
</div>

<script is:inline>
  const input = document.getElementById('search');
  const resultsEl = document.getElementById('results');
  let debounceTimer;

  // Never interpolate content into HTML: text can contain angle brackets,
  // quotes, or strings that resemble markup.
  function appendHighlighted(element, text = '', keyword = '') {
    const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    if (!escaped) {
      element.append(document.createTextNode(text));
      return;
    }
    const regex = new RegExp(escaped, 'gi');
    let offset = 0;
    for (const match of text.matchAll(regex)) {
      element.append(document.createTextNode(text.slice(offset, match.index)));
      const mark = document.createElement('mark');
      mark.className = 'bg-violet-400/30 text-violet-200 rounded px-0.5';
      mark.textContent = match[0];
      element.append(mark);
      offset = match.index + match[0].length;
    }
    element.append(document.createTextNode(text.slice(offset)));
  }

  function snippet(text = '', keyword = '', radius = 40) {
    const index = text.toLowerCase().indexOf(keyword.toLowerCase());
    const start = index < 0 ? 0 : Math.max(0, index - radius);
    const end = index < 0 ? Math.min(text.length, 80) : Math.min(text.length, index + keyword.length + radius);
    return (start > 0 ? '\u2026' : '') + text.slice(start, end) + (end < text.length ? '\u2026' : '');
  }

  function runSearch(value) {
    const keyword = value.trim();
    resultsEl.replaceChildren();
    resultsEl.classList.toggle('hidden', !keyword);
    if (!keyword) return;

    const results = (window.__SEARCH_INDEX__ ?? []).filter((item) =>
      [item.title, item.description, item.content].some((text) =>
        (text ?? '').toLowerCase().includes(keyword.toLowerCase())
      )
    ).slice(0, 5);

    if (!results.length) {
      const message = document.createElement('p');
      message.className = 'px-4 py-3 text-sm text-white/70';
      message.textContent = 'No results found';
      resultsEl.append(message);
      return;
    }

    for (const result of results) {
      const link = document.createElement('a');
      link.href = result.slug;
      link.className = 'group block px-4 py-3 transition hover:bg-violet-400/10 first:rounded-t-xl last:rounded-b-xl';
      const title = document.createElement('div');
      title.className = 'text-sm font-medium text-white group-hover:text-violet-300';
      appendHighlighted(title, result.title, keyword);
      link.append(title);

      const content = result.content || result.description;
      if (content) {
        const description = document.createElement('div');
        description.className = 'text-xs text-white/70 mt-1 leading-relaxed';
        appendHighlighted(description, snippet(content, keyword), keyword);
        link.append(description);
      }
      resultsEl.append(link);
    }
  }

  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => runSearch(input.value), 200);
  });
  document.addEventListener('click', (event) => {
    if (!event.target.closest('.search-container')) resultsEl.classList.add('hidden');
  });
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      clearTimeout(debounceTimer);
      resultsEl.classList.add('hidden');
    }
  });
</script>
