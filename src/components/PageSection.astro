---
interface Props {
  title: string;
  eyebrow: string;
  description: string;
  headingId: string;
}

const { title, eyebrow, description, headingId } = Astro.props;
---

<section class="page-section" aria-labelledby={headingId}>
  <header>
    <p class="eyebrow">{eyebrow}</p>
    <h1 id={headingId}>{title}</h1>
    <p class="description">{description}</p>
  </header>
  <div class="section-content">
    <slot />
  </div>
</section>

<style>
  .page-section { padding: 3rem 0 1.5rem; }
  .eyebrow { color: var(--accent); font-size: .65rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin-top: .75rem; font-size: clamp(1.8rem, 5vw, 2.5rem); line-height: 1.3; font-weight: 700; letter-spacing: -.055em; }
  .description { margin-top: 1rem; max-width: 32rem; font-size: .8rem; line-height: 1.9; color: var(--muted); }
  .section-content { margin-top: 2rem; }
  @media (max-width: 480px) { .page-section { padding-top: 2rem; } }
</style>
