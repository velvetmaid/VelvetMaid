---
interface Props {
  title?: string;
}

const { title = 'A small note' } = Astro.props;
---

<aside class="my-6 rounded-xl border border-violet-400/25 bg-violet-400/10 p-5">
  <p class="!mb-2 font-bold text-violet-900 dark:text-fuchsia-100">{title}</p>
  <div class="text-sm leading-relaxed opacity-80"><slot /></div>
</aside>