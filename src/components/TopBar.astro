---
import SearchBar from './SearchBar.astro';
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;
const links = [
  { href: '/stuff/', label: 'Stuff' },
  { href: '/notes/', label: 'Notes' },
];
---

<header class="site-header">
  <div class="header-row">
    <a class="site-brand" href="/">{SITE_TITLE}<span aria-hidden="true">✳</span></a>
    <nav class="site-nav" aria-label="Main navigation">
      {links.map(({ href, label }) => {
        const active = pathname.startsWith(href);
        return <a href={href} aria-current={active ? 'page' : undefined}>{label}</a>;
      })}
    </nav>
  </div>
  <SearchBar />
</header>

<style>
  .site-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
  .header-row { display: flex; flex: 1; flex-wrap: wrap; align-items: center; gap: 1.5rem; justify-content: space-between; }
  .site-brand { display: inline-flex; align-items: center; gap: .65rem; font-size: .9rem; font-weight: 700; letter-spacing: -.04em; }
  .site-brand span { color: var(--accent); font-size: 1.4rem; }
  .site-nav { display: flex; gap: .25rem; padding: .25rem; border: 1px solid var(--line); border-radius: .75rem; background: var(--wash); }
  .site-nav a { display: inline-flex; align-items: center; min-height: 2.75rem; border-radius: .5rem; padding: .5rem .7rem; font-size: .8rem; color: var(--muted); transition: background .15s, color .15s; }
  .site-nav a:hover, .site-nav a[aria-current] { color: var(--ink); background: var(--surface); box-shadow: 0 1px 4px #18112d0a; }
  @media (max-width: 420px) { .header-row { gap: 1rem; } .site-brand { font-size: .8rem; } .site-nav a { padding: .45rem .5rem; } }
</style>
