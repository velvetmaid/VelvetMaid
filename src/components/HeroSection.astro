---
import { PROFILE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import { toRouteSlug } from "../utils/urlSlug";

const { title, avatar } = Astro.props;
const latestEntries = await Promise.all(
    (["stuff", "notes"] as const).map(async (collection) => {
        const [entry] = (
            await getCollection(collection, ({ data }) => data.public)
        ).sort(
            (a, b) =>
                (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0) ||
                a.id.localeCompare(b.id),
        );

        return { collection, entry };
    }),
);
---

<div class="home-intro">
    <div class="intro-copy">
        <p class="eyebrow">{PROFILE.eyebrow}</p>
        <h1>
            Things nobody
            <br />
            <span>asked for.</span>
        </h1>
        <p class="intro-description">{SITE_DESCRIPTION}</p>
        <div class="latest">
            <span class="latest-label">Latest:</span>
            {
            latestEntries.map(({ collection, entry }) => entry && (
                <a
                    class="latest-entry"
                    href={`/${collection}/${toRouteSlug(entry.id)}/`}
                >
                    <span class="latest-title">
                        {entry.data.title}{" "}
                        <span aria-hidden="true">↗</span>
                    </span>
                </a>
            ))
            }
        </div>
    </div>
    <div class="profile-column">
        <aside class="profile-panel" aria-label="About this space">
            <img src={avatar} alt="" width="80" height="80" />
            <p class="profile-name">{title}</p>
            <p class="profile-introduction">{PROFILE.introduction}</p>
        </aside>
    </div>
</div>

<style>
    .home-intro {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 3rem;
        align-items: start;
        padding: 3.5rem 0 2.5rem;
    }
    .eyebrow {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1.25rem;
    }
    h1 {
        font-size: clamp(2rem, 4.5vw, 3.1rem);
        font-weight: 700;
        line-height: 1.25;
        letter-spacing: -0.065em;
    }
    h1 span {
        color: var(--accent);
    }
    .intro-description {
        margin-top: 0.50rem;
        max-width: 24rem;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.9;
    }
    .profile-column {
        min-width: 0;
        margin-top: 2.5rem;
    }
    .profile-panel {
        border-radius: 1rem;
        padding: 1.75rem;
        background: var(--wash);
    }
    img {
        width: 5rem;
        height: 5rem;
        object-fit: cover;
        border-radius: 1rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 2px 10px #23153c10;
    }
    .profile-name {
        font-size: 1rem;
        font-weight: 700;
    }
    .profile-introduction {
        margin-top: 0.75rem;
        font-size: 0.9rem;
        line-height: 1.9;
        color: var(--muted);
    }
    .latest {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem 1rem;
        max-width: 100%;
        margin-top: 0.75rem;
    }
    .latest-entry {
        border-radius: 0.25rem;
    }
    .latest-label {
        color: var(--muted);
        font-size: 0.75rem;
    }
    .latest-title {
        color: var(--ink);
        font-size: 0.85rem;
        text-decoration: underline;
        text-decoration-color: var(--line);
        text-underline-offset: 0.3em;
        transition: text-decoration-color 0.15s;
    }
    .latest-title span {
        margin-left: 0.4rem;
        color: var(--accent);
    }
    .latest-entry:hover .latest-title {
        text-decoration-color: var(--accent);
    }
    @media (max-width: 680px) {
        .home-intro {
            grid-template-columns: 1fr;
            gap: 2rem;
            padding: 2.5rem 0;
        }
        h1 {
            font-size: clamp(2rem, 8vw, 3rem);
        }
        .profile-column {
            margin-top: 0;
        }
        .profile-panel {
            padding: 1.5rem;
        }
    }
</style>
